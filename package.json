{
  "name": "genui-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=.env.local server/index.ts",
    "build": "tsc -b && vite build",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.server.json --outfile=server-dist/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx --tsconfig ./tsconfig.server.json --test --test-concurrency=1 \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "eval": "tsx --tsconfig ./tsconfig.server.json --env-file-if-exists=.env.local server/eval/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:traces": "drizzle-kit generate --config drizzle.traces.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:traces": "tsx --tsconfig ./tsconfig.server.json --env-file-if-exists=.env.local server/adapters/traces/migrateCli.ts && drizzle-kit migrate --config drizzle.traces.config.ts",
    "db:seed": "tsx --tsconfig ./tsconfig.server.json --env-file-if-exists=.env.local server/adapters/db/seedCli.ts",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.6",
    "ioredis": "^6.0.0",
    "openai": "^7.32.0",
    "pg": "^8.23.1"
  }
}
