{
  "id": "reusable-name-list",
  "prompt": "Show a list of the names Ana, Bo and Cy using our saved name list design.",
  "checks": [
    { "agentComponent": "NameList" },
    { "uiText": "Cy" }
  ],
  "customComponents": [
    {
      "name": "NameList",
      "description": "A column of names, one line per name.",
      "category": "display",
      "children": "none",
      "propsSchema": {
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The names to list."
          }
        },
        "required": [
          "names"
        ],
        "additionalProperties": false
      },
      "exampleProps": {
        "names": [
          "Ana"
        ]
      },
      "template": {
        "component": "Stack",
        "props": {},
        "children": [
          {
            "$each": "names",
            "as": {
              "component": "Text",
              "props": {
                "text": {
                  "$item": true
                }
              }
            }
          }
        ]
      }
    }
  ]
}
