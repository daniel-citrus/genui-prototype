# Copy to .env.local. The uncommented variables are the ones to set; the
# commented ones have defaults.

# OpenAI key for the agent. Without it the API starts but chat answers with an error.
OPENAI_API_KEY=

# Postgres holding the component catalog (docker compose up -d db).
DATABASE_URL=postgres://genui:genui@localhost:5432/genui

# Redis for shared rate-limit counters (docker compose up -d redis). If it is
# down, rate limiting is skipped; remove this line to count in process memory.
REDIS_URL=redis://localhost:6379

# Model the agent uses.
# AGENT_MODEL=gpt-4.1

# Most output tokens per model reply.
# AGENT_MAX_OUTPUT_TOKENS=2048

# Chat requests per IP per minute, and separately action clicks.
# AGENT_RATE_LIMIT_PER_MINUTE=20

# Number of reverse-proxy hops to trust for X-Forwarded-For. Leave unset unless
# the API is reachable only through a proxy you control; otherwise clients can
# spoof their IP and dodge the rate limit.
# TRUST_PROXY=1
