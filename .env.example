# Copy to .env.local (git-ignored) and fill in what you need.
# `npm run dev:api` loads .env.local when it exists; every value has a default.

# API server
API_PORT=3001
API_HOST=127.0.0.1
LOG_LEVEL=info

# Agent: leave OPENAI_API_KEY empty to run without the agent.
OPENAI_API_KEY=
AGENT_MODEL=gpt-4.1

# Postgres
DATABASE_URL=postgres://genui:genui@localhost:5432/genui

# Vite dev proxy target for /api (read by vite.config.ts).
# API_PROXY_TARGET=http://localhost:3001
